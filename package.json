{
    "name": "buttons-panel",
    "version": "2.4.3",
    "description": "A modern button panel plugin for quick access to files, commands, links, and scripts.",
    "author": "Kevin",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TracingOrigins/obsidian-buttons-panel-plugin.git"
    },
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node scripts/deploy.mjs dev && node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs build",
        "version": "node version-bump.mjs && git add package.json manifest.json versions.json",
        "lint": "eslint ."
    },
    "keywords": [
        "Buttons",
        "Buttons Panel",
        "Obsidian Plugin"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^22.15.17",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "esbuild": "0.25.5",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.4.0",
        "globals": "^17.6.0",
        "jiti": "^2.6.1",
        "obsidian": "latest",
        "prettier": "^3.6.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tslib": "2.4.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.59.1"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2"
    }
}
