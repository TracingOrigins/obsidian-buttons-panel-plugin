{
    "name": "buttons-panel",
    "version": "1.3.0",
    "description": "A modern button panel plugin for quick access to files, commands, links, and scripts.",
    "author": "Kevin",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TracingOrigins/obsidian-buttons-panel-plugin.git"
    },
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "build:vault": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/copy-to-vault.js"
    },
    "keywords": [
        "Buttons",
        "Buttons Panel",
        "Obsidian Plugin"
    ],
    "devDependencies": {
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "5.29.0",
        "@typescript-eslint/parser": "5.29.0",
        "builtin-modules": "3.3.0",
        "dotenv": "^16.0.0",
        "esbuild": "0.17.3",
        "obsidian": "latest",
        "prettier": "^3.6.2",
        "tslib": "2.4.0",
        "typescript": "4.7.4"
    }
}
