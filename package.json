{
    "name": "buttons-panel",
    "version": "2.1.4",
    "description": "A modern button panel plugin for quick access to files, commands, links, and scripts.",
    "author": "Kevin",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TracingOrigins/obsidian-buttons-panel-plugin.git"
    },
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node scripts/deploy.mjs dev && node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/deploy.mjs build",
        "version": "node version-bump.mjs && git add package.json manifest.json versions.json",
        "lint": "eslint ."
    },
    "keywords": [
        "Buttons",
        "Buttons Panel",
        "Obsidian Plugin"
    ],
    "devDependencies": {
        "@eslint/js": "9.30.1",
        "@types/node": "^16.11.6",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/sortablejs": "^1.15.9",
        "esbuild": "0.25.5",
        "eslint": "^9.39.2",
        "eslint-plugin-obsidianmd": "0.1.9",
        "globals": "14.0.0",
        "jiti": "2.6.1",
        "prettier": "^3.6.2",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tslib": "2.4.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "8.35.1"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "obsidian": "latest",
        "sortablejs": "^1.15.7"
    }
}
